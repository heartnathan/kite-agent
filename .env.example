# ===== Kite Agent(翼鸢)環境變數 =====
# 複製為 .env，再啟動時自動載入（也可由面板「環境變數」直接設定）。

# 對外唯一埠號（面板裡填的埠，必須與此一致）
PORT=8000
# 監聽位址
HOST=0.0.0.0

# ---- 資料庫（兩種擇一）----
# A. Turso 遠端（推薦，資料在雲端）：https://<db>.turso.io
#    建立後把 DATABASE_URL 與 TURSO_AUTH_TOKEN 填進面板環境變數。
DATABASE_URL=
TURSO_AUTH_TOKEN=
# B. 本機 SQLite（零外部依賴，檔案存在資料卷）
#    例如 LIBSQL_PATH=./data/app.db

# ---- LLM ----
# 不需要任何 LLM 環境變數!
# 啟動後打開網頁 -> 左下角 🔌 -> 新增供應商(填 base_url + api_key)
#   -> 拉取模型 -> 選一個設為預設。設定存在資料庫,重啟不消失。

# 可選：跨來源 CORS（一般同埠部署不需要）
# CORS_ORIGIN=https://your-domain.com
# 資料目錄（本機 sqlite / agent 沙盒檔案）
# Docker 內建議用 /data（ compose 已掛載 ./data:/data ）
DATA_DIR=./data
